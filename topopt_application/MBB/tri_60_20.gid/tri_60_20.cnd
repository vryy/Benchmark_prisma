QUESTION: Density_Water#UNITS#
VALUE: 1000.0kg/m^3
QUESTION: Density_Air#UNITS#
VALUE: 1.295kg/m^3
QUESTION: Porosity
VALUE: 0.2
QUESTION: Permeability_Water#UNITS#
VALUE: 0.0000044m/s
QUESTION: Permeability_Air#UNITS#
VALUE: 0.00000032m/s
QUESTION: perm_28#UNITS#
VALUE: 0.00000001m/s
