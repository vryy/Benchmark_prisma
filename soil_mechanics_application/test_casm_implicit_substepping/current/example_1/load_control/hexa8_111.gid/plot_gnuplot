set key right top

set xrange [0:1100]
set yrange [0:500]

M = 1.2
N = 3
R = 2.0
pc0 = 200.0
#pc1 = 508333.333333/1000
pc1 = 666666.66666/1000

set output "loading_path.pdf"
set xlabel "p' (kPa)"
set ylabel "q (kPa)"
set parametric
set trange [0.00001:1]
plot "analytical_loading_path.txt" using ($1)/1000:($2)/1000 with lines title "analytical loading path", \
     "loading_path.txt" using ($1)/1000:($2)/1000 with lines title "loading path", \
     pc0*t, M*pc0*t*((-log(t)/log(R))**(1.0/N)) title "initial yield envelope", \
     pc1*t, M*pc1*t*((-log(t)/log(R))**(1.0/N)) title "final yield envelope", \
     t*600, M*t*600 title "CSL"

unset parametric
unset xrange
unset yrange
set key right bottom

